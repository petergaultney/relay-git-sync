# Relay Server Configuration
RELAY_SERVER_URL=https://your-relay-server.com
RELAY_SERVER_API_KEY=your-api-key-here

# Webhook Authentication
# Generated by: git-sync generate-auth
WEBHOOK_SECRET=your-webhook-secret-here

# Data Storage Directory (optional)
# Defaults to current directory if not set
RELAY_GIT_DATA_DIR=/path/to/data

# Alternative: JWT Secret for API tokens (optional)
# Generate with: git-sync api keygen
# JWT_SECRET=jwt_your_jwt_secret_here
